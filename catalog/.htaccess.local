Options -Indexes

RewriteEngine on

RewriteCond %{HTTPS} =off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [QSA,L]

RewriteCond %{HTTP_HOST} !^www.
RewriteCond %{REQUEST_URI} (.*)
RewriteRule (.*) https://www.%{HTTP_HOST}%1 [R=301,L]

RewriteCond %{REQUEST_URI} (.*)/&(.*)
RewriteRule ^(.*)/&(.*) $1/?&$2 [L,R=301]

RewriteCond %{THE_REQUEST} \s/+(.*?)/{2,}([^\s]*)
RewriteCond %{REQUEST_URI} !(?:catalog) [NC]
RewriteRule ^ %1/%2 [R=301,L]

# Удаляем дублирующие слеши и перенаправляем на правильный URL
RewriteCond %{THE_REQUEST} \s/(.*)/{2,}(.*)\s
RewriteRule .* /%1/%2 [R=301,L]

# Перенаправляем на конечный URL без дублей слешей
RewriteRule ^catalog/operator_panels/$ catalog/operator_panels/?&brand=Weintek [QSA,R=301,L]

############# Убираем //////////// в любом месте УРЛ ######################### 1
