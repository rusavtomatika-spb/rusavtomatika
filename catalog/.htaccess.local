######################################
#RewriteCond %{THE_REQUEST} [\s?](?:.*)/([\w\d-_]*?)[/?]{2,}[^\?][\s?] [NC,OR]
#RewriteCond %{THE_REQUEST} [\s?](?:.*)[/?]{2,}([\w\d-_]*?)/[^\?][\s?] [NC,OR]
#RewriteCond %{THE_REQUEST} [\s?](?:.*)[/?]{2,}([\w\d-_]*?)[/?]{2,}[^\?][\s?] [NC]
#RewriteCond %{REQUEST_URI} !(?:news|articles|soft|updater|updater_source|xml|forum|cart|compare) [NC]
#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteCond %{QUERY_STRING} !(?:.*)(?:submit)(?:.*) [NC]
#RewriteCond %{THE_REQUEST} !\s(?:.*)/\?\s [NC]
#RewriteRule (.*) https://%{HTTP_HOST}/%1/ [R=301,L]

RewriteCond %{QUERY_STRING} "utm" [NC]
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,QSD]

RewriteCond %{QUERY_STRING} brand [NC]
RewriteCond %{QUERY_STRING} !(weintek|ifc|aplex|samkoon|ewon|faraday|smatipc|spiktek|licos) [NC]
RewriteRule (.*) https://%{HTTP_HOST}/? [R=404,L]

RewriteCond %{THE_REQUEST} \s/catalog/\?(.*)\s [NC]
RewriteRule (.*) https://%{HTTP_HOST}/? [R=404,L]

RewriteCond %{THE_REQUEST} \s/catalog/industrial-communication-equipment/?&interfaces=sfp\s [NC]
#RewriteRule ^(.*)$ /catalog/index.php?q=$1 [QSA]
RewriteRule ^/catalog/industrial-communication-equipment/(sfp)/$  /catalog/index.php?q=$1 [QSA]

RewriteRule ^.htaccess$ - [F]

RewriteCond %{REQUEST_URI} (.*)/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /catalog/index.php?q=$1 [QSA]

RewriteBase /catalog
RewriteCond %{QUERY_STRING} (brand=smatipc) [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule (.*) /index.php?q=catalog/embedded_computers/?&brand=IFC [C]
RewriteRule (.*) /catalog/embedded_computers/?&brand=IFC [R=301,L]

RewriteBase /catalog
RewriteCond %{QUERY_STRING} (series=IEXP) [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule (.*) /index.php?q=catalog/embedded_computers/?&series=BOX-PC [C]
RewriteRule (.*) /catalog/embedded_computers/?&series=BOX-PC [R=301,L]

RewriteBase /catalog
RewriteCond %{REQUEST_URI} !(/$|\.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule (.*) /catalog/index.php?q=$1 [QSA,C]
RewriteRule (.*) %{REQUEST_URI}/? [R=301,L]